{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "noveliaa",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/.well-known/**",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/authorize",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/token",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/register",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/revoke",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/api/integrations",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "/api/integrations/**",
        "function": {
          "functionId": "noveliaaMcp",
          "region": "asia-south1",
          "pinTag": true
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "noveliaa-plugin",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "test",
        "scripts",
        "src/index.mjs",
        "src/backup.mjs",
        "src/firebase-store.mjs"
      ]
    }
  ]
}

# Public Firebase client configuration only. Never put a service account here.
# Leave unset to show the production setup gate. DEV localhost ?local=1 offers
# an isolated device-only test notebook without cloud access.
# VITE_FIREBASE_CONFIG={"apiKey":"PUBLIC_WEB_API_KEY","authDomain":"VERIFIED_DOMAIN","projectId":"VERIFIED_PROJECT_ID","storageBucket":"VERIFIED_BUCKET","appId":"PUBLIC_APP_ID"}
VITE_FIREBASE_REGION=asia-south1
# Local development only; production builds reject emulator connections.
VITE_FIREBASE_EMULATORS=false
# Server values belong in functions/.env.<verified-project-id>, NOT this VITE file:
# NOVELIAA_OWNER_UID=<author Firebase Authentication UID>
# NOVELIAA_STORAGE_BUCKET=<verified primary bucket>
# NOVELIAA_BACKUP_BUCKET=<separate protected backup bucket>
# NOVELIAA_BACKUP_SERVICE_ACCOUNT=<separate backup-only service account email>

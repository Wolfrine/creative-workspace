# Public Firebase client configuration only. Never put a service account here.
# Hosting discovers /__/firebase/init.json; Actions also embeds verified public
# SDK settings. No Storage bucket, Functions region or model key is required.
# VITE_FIREBASE_CONFIG={"apiKey":"PUBLIC_WEB_API_KEY","authDomain":"VERIFIED_DOMAIN","projectId":"noveliaa","appId":"PUBLIC_APP_ID"}
# Development only; production rejects emulator connections.
VITE_FIREBASE_EMULATORS=false

{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "noveliaa": {
      "type": "streamable-http",
      "url": "https://noveliaa.web.app/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["noveliaa:read"],
            "defaultScopes": ["noveliaa:read", "noveliaa:propose"]
          }
        }
      }
    }
  }
}

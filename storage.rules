rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && firestore.exists(/databases/(default)/documents/noveliaaConfig/access)
        && firestore.get(/databases/(default)/documents/noveliaaConfig/access).data.ownerUid == uid;
    }
    match /noveliaaWorkspaces/{uid}/staging/{digest} {
      allow read: if owner(uid);
      allow create: if owner(uid) && resource == null && digest.matches('^[a-f0-9]{64}$')
        && request.resource.size <= 32 * 1024 * 1024
        && request.resource.contentType == 'application/octet-stream'
        && request.resource.metadata.sha256 == digest;
      allow update, delete: if false;
    }
    match /noveliaaWorkspaces/{uid}/blobs/{digest} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}

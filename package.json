{
  "name": "noveliaa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-noveliaa --config firebase.spark-test.json \"vitest run src/cloud/spark.emulator.test.ts\"",
    "test:cloud": "firebase emulators:exec --only auth,firestore --project demo-noveliaa --config firebase.spark-test.json \"playwright test --config playwright.spark.config.ts\"",
    "test:crash": "node scripts/crash-recovery.mjs",
    "profile:writing": "node scripts/profile-writing.mjs",
    "test:evidence": "python -m unittest discover -s evals -p test_*.py -v",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "firebase": "13.1.0",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.0.0",
    "firebase-tools": "^15.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
